<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">
        <record id="gate_in_sequence" model="ir.sequence">
            <field name="name">Gate Pass In Sequence</field>
            <field name="code">gate.pass.in</field>
            <field name="prefix">GPI/%(range_year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="gate_out_sequence" model="ir.sequence">
            <field name="name">Gate Pass Out Sequence</field>
            <field name="code">gate.pass.out</field>
            <field name="prefix">GPO/%(range_year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>