<?xml version='1.0' encoding='utf-8'?>

<odoo>
    <data>
        <record id='view_gate_pass_out_list' model='ir.ui.view'>
            <field name='name'>gate.pass.out.list</field>
            <field name='model'>gate.pass.out</field>
            <field name='arch' type='xml'>
                <list string='Gate Pass Out' create='false' sample='1'>
                    <field name='name' decoration-bf='1'/>
                    <field name='date'/>
                    <field name='partner_id'/>
                    <field name='location_id' optional='hide'/>
                    <field name='picking_id' optional='show'/>
                    <field name='total_qty' sum='Total Dispatched Qty'/>
                    <field name='company_id' groups='base.group_multi_company' optional='hide'/>
                    <field name='state' widget='badge' decoration-success="state == 'out'"
                           decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <record id='view_gate_pass_out_form' model='ir.ui.view'>
            <field name='name'>gate.pass.out.form</field>
            <field name='model'>gate.pass.out</field>
            <field name='arch' type='xml'>
                <form string='Gate Pass Out' create='false'>
                    <header>
                        <button name='action_out' string='Mark as Out' type='object' class='btn-primary'
                                invisible="state != 'draft'"/>
                        <button name='action_cancel' string='Cancel' type='object' class='btn-secondary'
                                invisible="state in ('out', 'cancel')" groups='stock.group_stock_manager'/>
                        <button name='action_reset_to_draft' string='Reset to Draft' type='object' class='btn-secondary'
                                invisible="state != 'cancel'" groups='stock.group_stock_manager'/>
                        <field name='state' widget='statusbar' statusbar_visible='draft,out'/>
                    </header>
                    <sheet>
                        <field name='sale_id' invisible='1'/>
                        <field name='purchase_id' invisible='1'/>

                        <div class='oe_button_box' name='button_box'>
                            <button name='action_view_picking' type='object' class='oe_stat_button' icon='fa-truck'
                                    invisible='not picking_id'>
                                <div class='o_stat_info'>
                                    <span class='o_stat_text'>Delivery Order</span>
                                </div>
                            </button>
                            <button name='action_view_sale' type='object' class='oe_stat_button' icon='fa-usd'
                                    invisible='not sale_id' groups='sales_team.group_sale_salesman'>
                                <div class='o_stat_info'>
                                    <span class='o_stat_text'>Sale Order</span>
                                </div>
                            </button>
                            <button name='action_view_purchase' type='object' class='oe_stat_button'
                                    icon='fa-credit-card'
                                    invisible='not purchase_id' groups='purchase.group_purchase_user'>
                                <div class='o_stat_info'>
                                    <span class='o_stat_text'>Purchase Order</span>
                                </div>
                            </button>
                        </div>
                        <div class='oe_title'>
                            <h1>
                                <field name='name' readonly='1'/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name='partner_id' options="{'no_create': True}" readonly="state != 'draft'"/>
                                <field name='location_id' options="{'no_create': True}" readonly="state != 'draft'"/>
                                <field name='company_id' options="{'no_create': True}" groups='base.group_multi_company'
                                       readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name='date' readonly="state != 'draft'"/>
                                <field name='picking_id' readonly='1'/>
                                <field name='reference'/>
                            </group>
                        </group>
                        <notebook>
                            <page string='Items' name='page_lines'>
                                <field name='line_ids' readonly='1'>
                                    <list>
                                        <field name='product_id' widget='product_line_description'
                                               options="{'no_create': True}"/>
                                        <field name='description'/>
                                        <field name='quantity'/>
                                        <field name='dispatched_qty'/>
                                        <field name='uom_id' options="{'no_create': True}"/>
                                        <field name='note'/>
                                    </list>
                                </field>
                                <group name='note_group' col='6' class='mt-2 mt-md-0'>
                                    <group colspan='4' class='order-1 order-lg-0'>
                                        <field colspan='2' name='note' nolabel='1' placeholder='Terms and conditions...'
                                               readonly="state != 'draft'"/>
                                    </group>
                                </group>
                            </page>
                            <page string='Additional Information' name='page_remarks'>
                                <group>
                                    <field name='remarks' placeholder='Add exit notes or security instructions here...'
                                           readonly="state != 'draft'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id='view_gate_pass_out_search' model='ir.ui.view'>
            <field name='name'>gate.pass.out.search</field>
            <field name='model'>gate.pass.out</field>
            <field name='arch' type='xml'>
                <search string='Gate Pass Out Search'>
                    <field name='name'/>
                    <field name='partner_id'/>
                    <field name='reference'/>
                    <field name='picking_id'/>
                    <filter name='filter_draft' string='Draft' domain="[('state','=','draft')]"/>
                    <filter name='filter_out' string='Out' domain="[('state','=','out')]"/>
                    <filter name='filter_cancel' string='Cancelled' domain="[('state','=','cancel')]"/>
                    <separator/>
                    <group expand='0' string='Group By...'>
                        <filter name='group_by_state' string='Status' domain='[]' context="{'group_by':'state'}"/>
                        <filter name='group_by_partner' string='Partner' domain='[]'
                                context="{'group_by':'partner_id'}"/>
                        <filter name='group_by_location' string='Location' domain='[]'
                                context="{'group_by':'location_id'}"/>
                        <filter name='group_by_date' string='Date' domain='[]' context="{'group_by':'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id='gate_pass_out_action_all' model='ir.actions.act_window'>
            <field name='name'>GatePass Out</field>
            <field name='type'>ir.actions.act_window</field>
            <field name='res_model'>gate.pass.out</field>
            <field name='view_mode'>list,form</field>
            <field name='search_view_id' ref='view_gate_pass_out_search'/>
            <field name='help' type='html'>
                <p class='o_view_nocontent_smiling_face'>
                    No Outward Gate Passes found.
                </p>
            </field>
        </record>

        <record id='gate_pass_out_action_pending' model='ir.actions.act_window'>
            <field name='name'>GatePass Out</field>
            <field name='type'>ir.actions.act_window</field>
            <field name='res_model'>gate.pass.out</field>
            <field name='view_mode'>list,form</field>
            <field name='context'>{'search_default_filter_draft': 1}</field>
            <field name='search_view_id' ref='view_gate_pass_out_search'/>
            <field name='help' type='html'>
                <p class='o_view_nocontent_smiling_face'>
                    No pending outward gate passes found.
                </p>
            </field>
        </record>

        <menuitem id='gate_pass_out_parent_menu'
                  name='Gate Out'
                  parent='gate_pass_root'
                  sequence='20'/>

        <menuitem id='gate_pass_out_pending_menu'
                  name='Pending'
                  parent='gate_pass_out_parent_menu'
                  action='gate_pass_out_action_pending'
                  sequence='10'/>

        <menuitem id='gate_pass_out_all_menu'
                  name='Gate Out'
                  parent='gate_pass_out_parent_menu'
                  action='gate_pass_out_action_all'
                  sequence='20'/>
    </data>
</odoo>