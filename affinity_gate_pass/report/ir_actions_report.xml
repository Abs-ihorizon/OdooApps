<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="action_report_gate_in" model="ir.actions.report">
            <field name="name">Gate In</field>
            <field name="model">gate.pass.in</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">affinity_gate_pass.report_gate_in_template</field>
            <field name="report_file">affinity_gate_pass.report_gate_in_template</field>
            <field name="print_report_name">'Gate Pass - %s' % (object.name)</field>
            <field name="binding_model_id" ref="affinity_gate_pass.model_gate_pass_in"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="affinity_gate_pass.paperformat_euro_custom"/>
        </record>

        <record id="action_report_gate_out" model="ir.actions.report">
            <field name="name">Gate Out</field>
            <field name="model">gate.pass.out</field>
