<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_relationship_status_mapping_list" model="ir.ui.view">
        <field name="name">document.relationship.status.mapping.list</field>
        <field name="model">document.relationship.status.mapping</field>
        <field name="arch" type="xml">
            <list string="Status Mappings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_config_id"/>
                <field name="technical_value"/>
                <field name="display_label"/>
                <field name="status_category"/>
                <field name="color"/>
                <field name="icon"/>
            </list>
        </field>
    </record>

    <record id="action_document_relationship_status_mapping" model="ir.actions.act_window">
        <field name="name">Status Mappings</field>
        <field name="res_model">document.relationship.status.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
