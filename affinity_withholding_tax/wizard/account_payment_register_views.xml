<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="account_register_payment_withholding_tax_views" model="ir.ui.view">
            <field name="name">account.register.payment.withholding.tax.view</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="after">
                    <notebook>
                        <page id="withholding_tab" string="Withholding Lines">
                            <field name="wht_lines" mode="list,form">
                                <list editable="bottom" string="Withholding Items">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="tax_id" options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="amount"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="currency_id" invisible="1"/>
                                            <field name="tax_id" options="{'no_create': True}"/>
                                            <field name="name"/>
                                            <field name="account_id" options="{'no_create': True}"/>
                                            <field name="amount"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>