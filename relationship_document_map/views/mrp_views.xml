<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_inherit_relationship_map" model="ir.ui.view">
        <field name="name">mrp.production.form.relationship.map</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="%(relationship_document_map.action_document_relationship_map)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-share-alt"
                        string="Rel Map">
                </button>
            </xpath>
        </field>
    </record>
</odoo>
