<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="abs_document_relationship_map.RelationshipMap" owl="1">
        <div class="o_action_relationship_map h-100 w-100" t-att-class="{ 'o_fullscreen': state.fullscreen }">
            <div class="o_relationship_map h-100 w-100 d-flex flex-column bg-view">
                <div class="o_map_header d-flex justify-content-between align-items-center p-2 border-bottom">
                    <h4 class="m-0" style="font-size: 1.1rem; font-weight: 600;">Document Relationship Map</h4>
                    <div>
                        <button class="btn btn-sm btn-secondary me-1" t-on-click="resetView" title="Reset View"><i class="fa fa-compress"/> Fit Screen</button>
                        <button class="btn btn-sm btn-secondary" t-on-click="toggleFullscreen" title="Fullscreen"><i class="fa fa-arrows-alt"/></button>
                    </div>
                </div>
                <div class="o_map_body flex-grow-1 position-relative overflow-hidden" style="background-color: #f0f4f8;">
                    
                                <!-- Partner Logo & Name Background Watermark -->
                    <div class="position-absolute top-0 start-0 p-4 d-flex align-items-center" style="z-index: 1; pointer-events: none; opacity: 0.15; filter: grayscale(100%);">
                        <t t-if="state.nodes.length &gt; 0 and state.nodes[0].partner_id">
                            <img t-attf-src="/web/image/res.partner/{{state.nodes[0].partner_id}}/avatar_128" 
                                 class="me-3" style="max-width: 150px; height: 54px; object-fit: contain;"/>
                        </t>
                        <i t-else="" class="fa fa-user me-3" style="font-size: 2.2rem;"/>
                        <h2 class="text-muted fw-bold m-0" style="font-size: 2.2rem; letter-spacing: -0.5px;">
                            <t t-esc="state.nodes.length &gt; 0 ? state.nodes[0].partner_name : ''"/>
                        </h2>
                    </div>

                    <div class="w-100 h-100 position-absolute top-0 start-0" style="z-index: 2;" t-ref="mapContainer"></div>
                    
                    <t t-if="state.loading">
                        <div class="position-absolute top-50 start-50 translate-middle text-center" style="z-index: 10;">
                            <i class="fa fa-circle-o-notch fa-spin fa-3x fa-fw text-primary"/>
                            <div class="mt-2 text-muted small">Loading Map...</div>
                        </div>
                    </t>
                    <t t-elif="state.error">
                        <div class="alert alert-danger m-3 position-absolute" style="z-index: 10;" role="alert">
                            <t t-esc="state.error"/>
                        </div>
                    </t>
                    <t t-elif="state.empty">
                        <div class="alert alert-info m-3 position-absolute" style="z-index: 10;" role="alert">
                            No relationships found for this document.
                        </div>
                    </t>
                    
                    <div class="html-nodes-container position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; z-index: 5;">
                        <t t-foreach="state.nodes" t-as="node" t-key="node.id">
                            <t t-set="theme" t-value="getNodeTheme(node)"/>
                            <div class="node-card position-absolute bg-white d-flex flex-column"
                                 t-att-id="'node_' + node.id"
                                 t-attf-style="width: 210px; height: 95px; display: none; transform-origin: center center; border-radius: 10px; border-top: 4px solid {{theme.docColor}}; box-shadow: 0 4px 15px rgba(0,0,0,0.06); padding: 12px; pointer-events: none;">
                                
                                <div class="d-flex justify-content-between align-items-center mb-1 flex-shrink-0">
                                    <div class="text-muted fw-bold text-uppercase text-truncate d-flex align-items-center" style="font-size: 0.6rem; letter-spacing: 0.5px;">
                                        <i t-attf-class="fa {{theme.icon}} me-1" t-attf-style="color: {{theme.docColor}}; font-size: 0.75rem;"/>
                                        <t t-esc="node.document_type"/>
                                    </div>
                                    <div class="fw-bold" t-attf-style="color: {{theme.statusColor}}; font-size: 0.6rem;">
                                        <t t-esc="node.state_label"/>
                                    </div>
                                </div>
                                
                                <div class="fw-bold mb-1 flex-shrink-0 text-truncate" t-attf-style="color: {{theme.docColor}}; font-size: 0.95rem; letter-spacing: -0.2px;">
                                    <t t-esc="node.name"/>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-end mt-auto flex-shrink-0 text-muted" style="font-size: 0.7rem;">
                                    <div t-if="node.date" class="text-truncate"><i class="fa fa-clock-o me-1"/> <t t-esc="node.date"/></div>
                                    <div t-if="node.amount" class="fw-bold text-dark text-nowrap ms-2"><t t-esc="node.amount"/> <t t-esc="node.currency"/></div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="p-2 text-muted text-center border-top" style="font-size: 0.75rem; background-color: #f8f9fa;">
                    <i>Double-click a node to open the document. Scroll to zoom. Drag to pan or move nodes.</i>
                </div>
            </div>
        </div>
    </t>
</templates>
