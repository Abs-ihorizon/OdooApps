<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_relationship_rule_list" model="ir.ui.view">
        <field name="name">document.relationship.rule.list</field>
        <field name="model">document.relationship.rule</field>
        <field name="arch" type="xml">
            <list string="Relationship Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_model_config_id"/>
                <field name="target_model_config_id"/>
                <field name="field_owner"/>
                <field name="relationship_field_id"/>
                <field name="edge_label"/>
                <field name="direction"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_document_relationship_rule_form" model="ir.ui.view">
        <field name="name">document.relationship.rule.form</field>
        <field name="model">document.relationship.rule</field>
        <field name="arch" type="xml">
            <form string="Relationship Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Purchase Order to Gate Pass"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="source_model_config_id"/>
                        </group>
                        <group string="Target">
                            <field name="target_model_config_id"/>
                        </group>
                    </group>
                    <group string="Relational Field">
                        <group>
                            <field name="field_owner"/>
                            <field name="relationship_model_id" readonly="1"/>
                            <field name="relationship_field_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="relationship_code"/>
                            <field name="edge_label"/>
                            <field name="edge_color" placeholder="#9ba4a8"/>
                            <field name="direction"/>
                            <field name="include_in_public_map"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_relationship_rule" model="ir.actions.act_window">
        <field name="name">Relationship Rules</field>
        <field name="res_model">document.relationship.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
