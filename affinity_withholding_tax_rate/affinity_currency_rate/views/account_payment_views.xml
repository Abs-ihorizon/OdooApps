<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="account_payment_form_inherit_custom" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.custom</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='memo']" position="after">
                    <field name="is_foreign_currency" invisible="1"/>
                    <field name="currency_rate" digits="[16, 12]" readonly="state != 'draft'"
                           invisible="not is_foreign_currency"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>